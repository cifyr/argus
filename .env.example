# Copy to .env. All local; nothing leaves your machine.
PORT=4200
SERVICE_NAME=Argus
OLLAMA_MODEL=llama3.2:3b
DB_PATH=argus.sqlite
POLL_MS=4000
# Send intake questions/acknowledgements over SMS automatically (needs Messages signed in). Set false to log-only.
AUTO_REPLY=true
# Optional: require ?token=... to open the console.
OPERATOR_TOKEN=
# Comma-separated numbers that receive auto-replies (blank = everyone when AUTO_REPLY=true).
REPLY_ALLOWLIST=
