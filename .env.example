# Copy to .env and fill in. Never commit .env.

# The number the relay calls and reads the message to. E.164.
TARGET_PHONE_NUMBER=+15550000001

# Your Google Voice number (informational, shown in logs). E.164.
GV_PHONE_NUMBER=+15550000000

# Protects /dashboard and /api/admin/*. Any long random string (12+ chars).
ADMIN_TOKEN=change-me-to-something-long

# Public URL phones use to reach the app (ngrok URL). Defaults to http://localhost:PORT.
PUBLIC_BASE_URL=

# Optional. Without it the message is read verbatim with a fixed intro instead of a Claude-written script.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# macOS `say` voice. `say -v '?'` lists them; download higher-quality voices in System Settings > Accessibility > Spoken Content.
TTS_VOICE=Samantha

# Chrome automation profile (sign in once with `npm run login`). Keep this dir private.
CHROME_PROFILE_DIR=.chrome-profile
HEADLESS=false

PORT=3000
POLL_INTERVAL_MS=4000
CALL_ANSWER_TIMEOUT_MS=45000
CALL_REPEAT=2
DB_PATH=relay.sqlite
LOCATION_MAX_AGE_MS=86400000
# Relay threads Google flags as "Suspected spam"? Default no.
RELAY_SPAM=false
# Relay unread texts that already existed when the relay started? Default no (they are recorded as preexisting).
RELAY_PREEXISTING=false
